{
	"name": "backlog-remote-mcp-server",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "node scripts/build-deploy-config.mjs && node scripts/push-secrets.mjs && wrangler deploy --config wrangler.deploy.json",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"type-check": "tsc -p tsconfig.cloudflare.json && tsc -p tsconfig.aws.json",
		"dev:https": "wrangler dev --local-protocol https",
		"check:local": "node scripts/local-mcp-check.mjs",
		"deploy:dry-run": "node scripts/build-deploy-config.mjs && wrangler deploy --dry-run --config wrangler.deploy.json",
		"secrets:push": "node scripts/build-deploy-config.mjs && node scripts/push-secrets.mjs",
		"secrets:dry-run": "node scripts/push-secrets.mjs --dry-run",
		"deploy:no-secrets": "node scripts/build-deploy-config.mjs && wrangler deploy --config wrangler.deploy.json",
		"test:aws-oauth": "tsx tests/aws-oauth-provider.test.mts",
		"aws:build": "sam build --template infra/aws/template.yaml",
		"aws:deploy": "node scripts/aws-deploy.mjs",
		"aws:validate": "sam validate --template infra/aws/template.yaml --lint",
		"aws:secrets:push": "node scripts/aws-push-secrets.mjs",
		"aws:secrets:dry-run": "node scripts/aws-push-secrets.mjs --dry-run",
		"aws:request-cert": "node scripts/aws-request-cert.mjs",
		"test:aws-consent": "tsx tests/aws-consent.test.mts",
		"test": "npm run test:aws-oauth && npm run test:aws-consent && npm run test:aws-store",
		"test:aws-store": "tsx tests/aws-store.test.mts"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1116.0",
		"@aws-sdk/client-secrets-manager": "^3.1116.0",
		"@aws-sdk/lib-dynamodb": "^3.1116.0",
		"@cloudflare/workers-oauth-provider": "^0.8.1",
		"@modelcontextprotocol/sdk": "1.29.0",
		"agents": "^0.17.1",
		"express": "^5.2.1",
		"hono": "^4.13.3",
		"jose": "^6.2.10",
		"serverless-http": "^4.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260820.1",
		"@types/express": "^5.0.6",
		"@types/node": "^22.15.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.12",
		"typescript": "^5.7.0",
		"wrangler": "^4.125.0"
	}
}
